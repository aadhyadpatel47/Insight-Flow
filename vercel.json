{
  "version": 2,
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python",
      "config": {
        "python": "3.11",
        "includeFiles": "{index.html,templates/**}",
        "maxDuration": 300
      }
    }
  ],
  "functions": {
    "app.py": {
      "maxDuration": 300,
      "includeFiles": "{index.html,templates/**}"
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "app.py"
    }
  ]
}

