{
  "version": 2,
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python",
      "config": {
        "python": "3.11",
        "includeFiles": [
          "engine.py",
          "template/**",
          "templates/**"
        ],
        "maxDuration": 300
      }
    }
  ],
  "functions": {
    "app.py": {
      "maxDuration": 300,
      "includeFiles": [
        "engine.py",
        "template/**",
        "templates/**"
      ]
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "app.py"
    }
  ]
}
