{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "excludeFiles": "{__pycache__/**,api/__pycache__/**,**/*.pyc,.venv/**,venv/**,.env,.env.*}"
    }
  }
}
